# Canonical site URL used for metadata (OpenGraph, canonical links, sitemap).
# Falls back to https://www.lablog.tech if unset.
NEXT_PUBLIC_SITE_URL=https://www.lablog.tech

# Google Tag Manager container ID. Falls back to the production container (GTM-PMQZJJQF) if unset.
NEXT_PUBLIC_GTM_ID=GTM-PMQZJJQF

# Google Search Console site-verification token. Falls back to the current production token if unset.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=9yT3QmKh9OdV1RNBWQkSrwOdB4g597REHoV8YcL3i5g
